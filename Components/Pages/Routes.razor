@page "/routes"
@rendermode InteractiveServer
@inject TransitService Transit

<PageTitle>Routes and stops · CampusTransit</PageTitle>

<PageHeader Title="Routes &amp; stops"
            Subtitle="Every published service on the campus network, its stop sequence and published headway.">
    <Actions>
        <a class="btn btn-primary" href="map"><Icon Name="map"/> Track these routes</a>
    </Actions>
</PageHeader>

@if (loading)
{
    <div class="card"><div class="card-body stack">
        <div class="skeleton" style="width:35%"></div>
        <div class="skeleton" style="width:65%"></div>
    </div></div>
}
else
{
    <div class="grid grid-2">
        @foreach (var route in routes)
        {
            var vehicles = shuttles.Where(s => s.TransitRouteId == route.Id).ToList();
            var inService = vehicles.Count(v => v.Status == ShuttleStatus.InService);
            var seats = vehicles.Sum(v => Math.Max(0, v.Capacity - v.Occupancy));

            <section class="card">
                <div class="card-head">
                    <div class="stack" style="gap:.15rem">
                        <div class="row">
                            <span class="route-dot" style="--dot:@route.ColorHex"></span>
                            <h2>@route.Name</h2>
                        </div>
                        <span class="sub mono">@route.Code &middot; every @route.HeadwayMinutes min</span>
                    </div>
                    <span class="badge @(route.IsActive ? "badge-success" : "badge-outline")">
                        @(route.IsActive ? "Operating" : "Suspended")
                    </span>
                </div>

                <div class="card-body stack" style="gap:.9rem">
                    <p class="muted" style="font-size:.85rem">@route.Description</p>

                    <div class="grid grid-stats" style="gap:.6rem">
                        <div class="stack" style="gap:0">
                            <span class="stat-label">Vehicles</span>
                            <strong style="font-size:1.15rem">@inService<span class="muted"> / @vehicles.Count</span></strong>
                        </div>
                        <div class="stack" style="gap:0">
                            <span class="stat-label">Seats free</span>
                            <strong style="font-size:1.15rem">@seats</strong>
                        </div>
                        <div class="stack" style="gap:0">
                            <span class="stat-label">Stops</span>
                            <strong style="font-size:1.15rem">@route.Stops.Count</strong>
                        </div>
                    </div>
                </div>

                <div class="list">
                    @foreach (var stop in route.Stops.OrderBy(s => s.Sequence))
                    {
                        <div class="list-item static">
                            <span class="avatar" style="width:26px;height:26px;font-size:.72rem;background:var(--surface-2);color:var(--text-muted)">
                                @stop.Sequence
                            </span>
                            <div class="grow stack" style="gap:.1rem">
                                <strong style="font-size:.85rem">@stop.Name</strong>
                                <span class="mono subtle" style="font-size:.72rem">
                                    @stop.Latitude.ToString("F5"), @stop.Longitude.ToString("F5")
                                </span>
                            </div>
                            <Icon Name="pin" Class="subtle"/>
                        </div>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    private bool loading = true;
    private List<TransitRoute> routes = [];
    private List<Shuttle> shuttles = [];

    protected override async Task OnInitializedAsync()
    {
        routes = await Transit.GetRoutesAsync();
        shuttles = await Transit.GetShuttlesAsync();
        loading = false;
    }
}
